<mxfile host="app.diagrams.net"><diagram name="D0_Data_Flow"><mxGraphModel page="1" pageWidth="1600" pageHeight="1080"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Veer&#10;Goal: Convert driver speech into routing constraints for hands-free live navigation.&#10;Flows A and B: speech-driven navigation and immediate privacy control" style="text;html=0;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="15" width="1510" height="140" /></mxCell><mxCell id="capture" value="C1 Capture speech&#10;raw audio in memory" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#deedf9;strokeColor=#54718d;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="235" width="380" height="100" /></mxCell><mxCell id="interpret" value="C2 Interpret utterance&#10;transcript -&gt; constraint" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#deedf9;strokeColor=#54718d;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="235" width="400" height="100" /></mxCell><mxCell id="plan" value="C3 Propose route&#10;places + weather + route" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#deedf9;strokeColor=#54718d;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="235" width="380" height="100" /></mxCell><mxCell id="confirm" value="C1 Speak proposal&#10;wait for explicit &quot;okay&quot;" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#deedf9;strokeColor=#54718d;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="485" width="380" height="100" /></mxCell><mxCell id="approval" value="C2 Interpret approval&#10;accept / reject / unknown" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#deedf9;strokeColor=#54718d;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="485" width="400" height="100" /></mxCell><mxCell id="apply" value="C1 Activate approved route&#10;map + spoken directions" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#deedf9;strokeColor=#54718d;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="485" width="380" height="100" /></mxCell><mxCell id="mute" value="Passenger tap or&#10;local voice mute request" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#edf1f5;strokeColor=#54718d;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="740" width="380" height="100" /></mxCell><mxCell id="stop" value="C1 Close capture gate&#10;stop mic; purge buffers" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#deedf9;strokeColor=#54718d;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="740" width="400" height="100" /></mxCell><mxCell id="state" value="E1 Phone mic stopped&#10;C1 indicator = muted" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#edf1f5;strokeColor=#54718d;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="740" width="380" height="100" /></mxCell><mxCell id="edge0" value="I2: PCM frames +&#10;JSON metadata" edge="1" parent="1" source="capture" target="interpret" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=18;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="I4 via C1:&#10;constraint JSON" edge="1" parent="1" source="interpret" target="plan" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=18;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="I4 reply: proposal&#10;JSON" edge="1" parent="1" source="plan" target="confirm" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=18;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="I2: approval audio&#10;PCM + metadata" edge="1" parent="1" source="confirm" target="approval" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=18;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge4" value="I2 reply: intent&#10;JSON" edge="1" parent="1" source="approval" target="apply" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=18;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge5" value="MuteRequest&#10;local event" edge="1" parent="1" source="mute" target="stop" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=18;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge6" value="I1: stop + state&#10;local events" edge="1" parent="1" source="stop" target="state" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=18;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="legend" value="Legend: blue boxes = team processing; gray dashed boxes = external input or phone platform.&#10;Arrows label data and form. Only accept activates the route; reject/unknown/silence leave it unchanged.&#10;Update &lt;= 3 s after &quot;okay&quot; ends; mute &lt;= 1 s; forced stop &lt;= 2 s. Audio stays transient." style="text;html=0;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="955" width="1520" height="110" /></mxCell></root></mxGraphModel></diagram></mxfile>